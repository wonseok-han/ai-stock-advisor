# 지금이니?! (Nowini) - Backend Environment Variables
#
# 사용법 (권장):
#   1) 이 파일을 .env.local 로 복사 (.gitignored)
#        cp apps/api/.env.example apps/api/.env.local
#   2) 값 채움 후 `make api-dev` 실행
#      → Makefile 이 apps/api/.env.local 을 자동 source 해서 JVM 에 환경변수 주입.
#         Spring Boot 는 dotenv 를 직접 지원하지 않으므로 Make 레벨에서 처리함.
#   3) IDE 로 기동할 때는 Run Configuration → Environment Variables 에 수동 등록 필요.
#
# YAML 오버라이드 대안: application.example.yml → application-local.yml 복사 후 편집.
#   env 하나로 충분한 경우 대부분 불필요.
#
# 주의: 서버 전용 시크릿. 절대 FE (.env.local) 에 복사하지 말 것.

# ===== Database (Supabase PostgreSQL) =====
# Supabase 프로젝트 Settings > Database 에서 Connection String 복사
DATABASE_URL=jdbc:postgresql://localhost:5432/aistockadvisor
DATABASE_USERNAME=dev
DATABASE_PASSWORD=dev

# ===== Cache (Upstash Redis) =====
# https://console.upstash.com → Database → REST URL/Token 또는 Redis URL
REDIS_URL=redis://localhost:6379

# ===== External Data Providers =====
# https://finnhub.io (무료 60 req/min) — search / profile / quote / news 담당.
# 주의: /stock/candle 은 무료 플랜 403. 캔들은 아래 Twelve Data 사용.
FINNHUB_API_KEY=

# https://twelvedata.com (무료 800 req/day, 8 req/min) — OHLCV 캔들 담당.
TWELVE_DATA_API_KEY=

# https://financialmodelingprep.com (무료 250 req/day) — market movers (gainers/losers) 담당.
FMP_API_KEY=

# https://www.alphavantage.co (legacy fallback, 5 req/min). 현재 미사용.
ALPHAVANTAGE_API_KEY=

# SEC EDGAR 공개 API (API key 불필요). User-Agent 헤더에 연락처 이메일 필수 (EDGAR 정책).
SEC_EDGAR_CONTACT_EMAIL=

# ===== AI =====
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ===== Web Push (Phase 4.2) =====
# VAPID 키 생성: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@nowini.app

# ===== Auth (Phase 4) =====
# Supabase 프로젝트 URL (JWKS 기반 JWT 검증에 사용)
# https://{project-ref}.supabase.co
SUPABASE_URL=

# ===== Yahoo Finance Proxy (Rate Limit 우회) =====
# Webshare.io 등 프록시 서비스 URL. 쉼표로 구분하면 매 요청마다 랜덤 로테이션.
# 형식: http://user:pass@host:port 또는 socks5://user:pass@host:port
# 예시: http://usr:pw@p.webshare.io:10001,http://usr:pw@p.webshare.io:10002
YAHOO_PROXY_URL=

# ===== Email (Resend) =====
# https://resend.com — 피드백 이메일 알림 발송용.
# API Key: Dashboard > API Keys 에서 생성.
RESEND_API_KEY=
# 피드백 수신 이메일 주소
CONTACT_EMAIL=

# ===== Runtime =====
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_LOG_LEVEL=DEBUG
